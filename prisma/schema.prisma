generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  preferredCurrency String @default("NGN")
  currencyConfirmedAt DateTime?
  deletedAt DateTime?
  onboardingCompletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monthlyPlans MonthlyPlan[]
  planningActions PlanningAction[]
  statementCategoryRules StatementCategoryRule[]
  statementImports StatementImport[]
  accounts       FinancialAccount[]
  incomeSources  IncomeSource[]
  expectedIncome ExpectedIncome[]
  obligations    Obligation[]
}

model FinancialAccount {
  id        String   @id @default(cuid())
  userId    String
  name      String
  balance   Decimal  @db.Decimal(18, 2)
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IncomeSource {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      IncomeSourceType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expectedIncome ExpectedIncome[]

  @@index([userId])
}

model ExpectedIncome {
  id           String               @id @default(cuid())
  userId       String
  sourceId     String?
  title        String
  amount       Decimal              @db.Decimal(18, 2)
  expectedDate DateTime
  confidence   IncomeConfidence
  status       ExpectedIncomeStatus @default(EXPECTED)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source IncomeSource? @relation(fields: [sourceId], references: [id])

  @@index([userId])
  @@index([expectedDate])
}

model Obligation {
  id        String             @id @default(cuid())
  userId    String
  title     String
  amount    Decimal            @db.Decimal(18, 2)
  dueDate   DateTime
  priority  ObligationPriority
  status    ObligationStatus   @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  planPayments PlanTransactionLink[]
  @@index([dueDate])
}

enum IncomeSourceType {
  FREELANCE
  SALARY
  CONTRACT
  CREATOR
  COMMISSION
  BUSINESS
  GIG
  OTHER
}

enum IncomeConfidence {
  CONFIRMED
  LIKELY
  UNCERTAIN
}

enum ExpectedIncomeStatus {
  EXPECTED
  RECEIVED
  PARTIAL
  DELAYED
  CANCELLED
}

enum ObligationPriority {
  ESSENTIAL
  IMPORTANT
  FLEXIBLE
  OPTIONAL
}

enum ObligationStatus {
  PENDING
  FUNDED
  PAID
  SKIPPED
}

model StatementImport {
  id String @id @default(cuid())
  userId String
  digest String
  format String
  currency String
  parserVersion String
  status String @default("REVIEW")
  createdAt DateTime @default(now())
  importedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions StatementTransaction[]
  @@unique([userId, digest])
  @@index([userId, createdAt])
}

model StatementTransaction {
  id String @id @default(cuid())
  importId String
  sourceRow Int
  date DateTime @db.Date
  description String
  amountMinor Decimal @db.Decimal(16, 0)
  direction String
  category String
  parsedCategory String
  confidence Float
  reason String
  approved Boolean @default(false)
  reviewedAt DateTime?
  planLinks PlanTransactionLink[]
  planningActions PlanningAction[]
  statement StatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  @@unique([importId, sourceRow])
  @@index([importId, approved])
}

model StatementCategoryRule {
  id String @id @default(cuid())
  userId String
  counterpartyKey String
  counterpartyName String
  direction String
  currency String
  category String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, counterpartyKey, direction, currency], map: "StatementCategoryRule_match_key")
  @@index([userId])
}

model MonthlyPlan {
  mode String @default("LINKED")
  startingFundsMinor Decimal @default(0) @db.Decimal(16, 0)
  id          String                @id @default(cuid())
  userId      String
  month       String
  currency    String
  bufferMinor Decimal               @default(0) @db.Decimal(16, 0)
  revision    Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories  PlanCategory[]
  links       PlanTransactionLink[]

  @@unique([userId, month, mode])
}

model PlanCategory {
  id             String                @id @default(cuid())
  planId         String
  name           String
  group          String
  kind           String
  position       Int
  allocatedMinor Decimal               @default(0) @db.Decimal(16, 0)
  targetMinor    Decimal               @default(0) @db.Decimal(16, 0)
  savedMinor     Decimal               @default(0) @db.Decimal(16, 0)
  targetDate     DateTime?             @db.Date
  matches        Json                  @default("[]")
  plan           MonthlyPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  links          PlanTransactionLink[]

  @@index([planId])
}

model PlanTransactionLink {
  id            String               @id @default(cuid())
  planId        String
  transactionId String
  categoryId    String?
  obligationId  String?
  ignored       Boolean              @default(false)
  plan          MonthlyPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  transaction   StatementTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category      PlanCategory?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  obligation    Obligation?          @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@unique([planId, transactionId])
  @@index([transactionId])
  @@index([categoryId])
  @@index([obligationId])
}

model PlanningAction {
  id            String               @id @default(cuid())
  userId        String
  transactionId String
  kind          String
  recordId      String
  createdAt     DateTime             @default(now())
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   StatementTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, kind])
  @@index([userId])
}
