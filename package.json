{
  "name": "flowmoney",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:all": "concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:web": "pnpm --filter @flowmoney/web dev",
    "dev:api": "pnpm --filter @flowmoney/api start:dev",
    "build": "pnpm --filter @flowmoney/web build",
    "build:api": "pnpm --filter @flowmoney/api build",
    "typecheck": "pnpm --filter @flowmoney/web typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "concurrently": "^10.0.6",
    "prisma": "^6.19.3"
  }
}
